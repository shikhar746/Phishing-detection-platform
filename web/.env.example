# Base URL of the Express API in ../api
NEXT_PUBLIC_API_URL=http://localhost:8080

# true (default): use realistic mock data stored in the browser.
# false: call the real API for auth, scans, reports and admin.
NEXT_PUBLIC_USE_MOCKS=true

# Mock mode only: fraction of requests (0-1) that fail, to preview error states.
NEXT_PUBLIC_MOCK_FAILURE_RATE=0

# Google sign-in: OAuth client ID (type "Web application"), same value as GOOGLE_CLIENT_ID in api/.env.
# Add http://localhost:3000 to its Authorized JavaScript origins. Dummy value below.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=temp-client-id.apps.googleusercontent.com
