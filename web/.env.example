# Demo mode. true (default): realistic mock data stored in the browser, no
# backend needed. false: every page uses the real API.
NEXT_PUBLIC_USE_MOCKS=true

# Where Next.js proxies /api/* (server-side). The browser only talks to this
# site, so the API's auth cookies stay first-party.
API_ORIGIN=http://localhost:8080

# Leave empty to use the proxy above. Only set it to make the browser call the
# API directly (then also set COOKIE_SAMESITE=none and CORS_ORIGIN on the API).
NEXT_PUBLIC_API_URL=

# Google sign-in: OAuth client ID (type "Web application"), same value as GOOGLE_CLIENT_ID in api/.env.
# Add this site's origin (e.g. http://localhost:3000) to its Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=temp-client-id.apps.googleusercontent.com

# Demo mode only: fraction of requests (0-1) that fail, to preview error states.
NEXT_PUBLIC_MOCK_FAILURE_RATE=0
