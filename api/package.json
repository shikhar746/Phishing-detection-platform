{
    "name": "api",
    "version": "1.0.0",
    "description": "REST API for PhishLens: auth, scans, reports and admin (MongoDB)",
    "main": "dist/server.js",
    "directories": {
        "test": "test"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "build:core": "npm --prefix ../packages/core run build",
        "predev": "npm --prefix ../packages/core run build",
        "prebuild": "npm --prefix ../packages/core run build",
        "pretest": "npm --prefix ../packages/core run build",
        "pretypecheck": "npm --prefix ../packages/core run build",
        "seed": "tsx src/scripts/seed.ts",
        "db:local": "tsx scripts/local-mongo.ts"
    },
    "keywords": [],
    "type": "module",
    "dependencies": {
        "@phishlens/core": "*",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "google-auth-library": "^11.1.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.11.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.3",
        "@types/supertest": "^7.2.1",
        "mongodb-memory-server": "^11.3.0",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=22.12"
    }
}
