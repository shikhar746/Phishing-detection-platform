# Copy to .env and replace every value. All values below are dummies.

# Server
PORT=8080
NODE_ENV=development
# Web origins allowed to call the API directly with cookies (comma-separated).
# Not needed when the web app proxies /api (the default setup).
CORS_ORIGIN=http://localhost:3000
# Reverse proxies in front of the API: 0 locally, 1 behind Render's load
# balancer, 2 behind Render + the Vercel /api proxy. Never higher than reality,
# or clients can forge the IP the rate limiter sees.
TRUST_PROXY=0
# lax when the web app proxies /api (same site); none only for direct cross-site calls
COOKIE_SAMESITE=lax

# Auth — use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=dummy-access-token-secret-change-me
REFRESH_SECRET=dummy-refresh-token-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Leave GOOGLE_CLIENT_ID empty to disable Google sign-in. Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in web/.env.local.
GOOGLE_CLIENT_ID=1234567890-dummyclientid.apps.googleusercontent.com

# MongoDB. Local: run `npm run db:local` (no install needed) and keep this URI.
# Atlas: Database > Connect > Drivers, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/phishlens
MONGODB_URI=mongodb://127.0.0.1:27017/ai-phishing
# Optional: overrides the database name in the URI (default: the URI's, else "phishlens")
# MONGODB_DB=phishlens
# Only if mongodb+srv:// fails with "querySrv ECONNREFUSED" (some VPN/WARP setups):
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Threat-intel APIs (optional: without them scans use the rules alone)
# https://www.virustotal.com/gui/my-apikey  (free tier: 4 lookups/minute)
VIRUSTOTAL_API_KEY=dummy-virustotal-api-key
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=dummy-safe-browsing-api-key

# Rate limits: failed sign-ins per IP, and scans per user (or per IP when anonymous), per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10
SCAN_RATE_LIMIT_MAX=30
