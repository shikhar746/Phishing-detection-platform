# Copy to .env and replace every value. All values below are dummies.

# Server
PORT=8080
NODE_ENV=development
# Comma-separated list of web origins allowed to call the API with cookies
CORS_ORIGIN=http://localhost:3000

# Auth — use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=dummy-access-token-secret-change-me
REFRESH_SECRET=dummy-refresh-token-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Leave GOOGLE_CLIENT_ID empty to disable Google sign-in. Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in web/.env.local.
GOOGLE_CLIENT_ID=1234567890-dummyclientid.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Supabase (Project Settings > API). The service-role key must stay server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key-replace-me

# Threat-intel APIs
VIRUSTOTAL_API_KEY=dummy-virustotal-api-key
GOOGLE_SAFE_BROWSING_API_KEY=dummy-safe-browsing-api-key

# Rate limiting for auth endpoints (failed attempts per window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=10
